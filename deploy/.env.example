# Copy to .env next to docker-compose.yml. This file holds the master key and
# the database password, so it stays out of the repository.

# Protects every secret in the database: Reality private keys, user passwords,
# node state. 64 hex characters; generate it with:
#
#   openssl rand -hex 32
#
# (Not with "docker compose run ... genkey": Compose refuses to run anything
# at all until this variable is set, so that command cannot produce it.)
#
# Back it up. Losing it means losing every stored secret; changing it makes
# them unreadable.
WN_MASTER_KEY=

# Any long random string. Only the database and the panel ever see it.
WN_DB_PASSWORD=

# Where the panel is reached. Must already resolve to this host: Caddy gets a
# certificate for it on first request.
WN_PANEL_DOMAIN=panel.example.com

# Where subscription links point. A separate name means a blocked subscription
# host does not take the panel with it. To serve both on one name, leave it
# empty and delete the subscription block from Caddyfile ("One name instead
# of two" in DEPLOY.md).
WN_SUB_DOMAIN=sub.example.com

# host:port the agents connect to, as written into the install command. The
# port has to match WN_GRPC_PORT below and be reachable from each node.
WN_GRPC_ADVERTISE=panel.example.com:8443

# Where the admin interface lives. An unguessable path keeps the login form
# out of the way of anything scanning for one.
WN_PANEL_PATH=/admin

# Optional.
#WN_GRPC_PORT=8443
#WN_DB_NAME=whitenet
#WN_DB_USER=whitenet
#WN_LOG_LEVEL=info
#WN_LOG_FORMAT=json
